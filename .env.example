# Sentry error logging. Copy to `.env` (git-ignored) and fill in to enable.
# See src/sentry.ts (runtime init) and vite.config.ts (source-map upload).

# --- Client (shipped to the browser) ---

# Public Sentry DSN. Safe to expose in the bundle. Leave EMPTY to disable Sentry
# entirely (init is skipped, zero overhead).
VITE_SENTRY_DSN=

# Optional build/release id (e.g. a git sha or version tag) used to tag events.
# Must match SENTRY_RELEASE below so uploaded source maps resolve.
VITE_SENTRY_RELEASE=

# --- Build-time only (NEVER prefix the auth token with VITE_; it must not ship to the client) ---

# Auth token with project source-map upload scope. When EMPTY, the Sentry Vite
# plugin is omitted and `vite build` still succeeds with no maps uploaded.
SENTRY_AUTH_TOKEN=

# Sentry org and project slugs.
SENTRY_ORG=
SENTRY_PROJECT=

# Release name for the uploaded source maps. Should match VITE_SENTRY_RELEASE.
SENTRY_RELEASE=
